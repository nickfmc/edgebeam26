      "margin": true,
      "padding": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Small",
          "slug": "small",
          "shadow": "0 1px 2px 0 rgb(0 0 0 / 0.05)"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "shadow": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
        },
        {
          "name": "Large",
          "slug": "large",
          "shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "shadow": "0 25px 50px -12px rgb(0 0 0 / 0.25)"
        }
      ]
    },
    "dimensions": {
      "defaultAspectRatios": false,
      "aspectRatio": true,
      "minHeight": true
    },
    "position": {
      "sticky": true
    },
    "background": {
      "backgroundImage": true,
      "backgroundSize": true
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#1d252d"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "fontSize": "18px",
      "lineHeight": "1.875"
    },
    "spacing": {
      "blockGap": "8px",
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--lg)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--lg)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "#3B82F6"
        },
        ":hover": {
          "color": {
            "text": "#1D4ED8"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "#3B82F6",
          "text": "#ffffff"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--body)",
          "fontWeight": "500"
        },
        "border": {
          "radius": "2px"
        },
        "variations": {
          "outline": {
            "color": {
              "background": "transparent",
              "text": "#3B82F6"
            },
            "border": {
              "color": "#3B82F6",
              "width": "2px"
            }
          }
        }
      },
      "core/heading": {
        "color": {
          "text": "#374151"
        }
      },
      "core/paragraph": {
        "color": {
          "text": "#374151"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)"
        }
      },
      "core/group": {
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--lg)",
            "right": "var(--wp--preset--spacing--lg)",
            "bottom": "var(--wp--preset--spacing--lg)",
            "left": "var(--wp--preset--spacing--lg)"
          }
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--lg)"
        }
      },
      "core/cover": {
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--xl)",
            "right": "var(--wp--preset--spacing--lg)",
            "bottom": "var(--wp--preset--spacing--xl)",
            "left": "var(--wp--preset--spacing--lg)"
          }
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Page without Title",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "single-full-width",
      "title": "Single Post Full Width",
      "postTypes": [
        "post"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "sidebar",
      "title": "Sidebar",
      "area": "uncategorized"
    }
  ]
}